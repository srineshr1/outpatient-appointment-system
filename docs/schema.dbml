// Schedule Project
// Live diagram: https://dbdiagram.io/embed#%2BIEFQUE9JTlRNRU5ULmFwcG9pbnRtZW50X2lkXQogIG9sZF9zbG90X2lkIGludGVnZXIgW25vdCBudWxsLCByZWY6ID4gU0xPVC5zbG90X2lkXQogIG5ld19zbG90X2lkIGludGVnZXIgW25vdCBudWxsLCByZWY6ID4gU0xPVC5zbG90X2lkXQogIHJlc2NoZWR1bGVkX2F0IHRpbWVzdGFtcCBbbm90IG51bGwsIGRlZmF1bHQ6IGBub3coKWBdCn0%3D

Table USER {
  user_id integer [primary key, increment]
  name varchar [not null]
  email varchar [not null, unique]
  phone varchar [unique]
  password varchar [note: 'Empty when auth_provider is google']
  auth_provider varchar [not null, note: 'email | phone | google']
  role varchar [not null, note: 'patient | doctor']
  is_verified boolean [not null, default: false]

  Note: 'Login account. A patient is a user with role = patient.'
}

Table PATIENT {
  patient_id integer [primary key, increment]
  user_id integer [not null, unique, ref: - USER.user_id]
  date_of_birth date
  gender varchar
  address varchar

  Note: 'Profile for a user whose role is patient. One user, one patient row.'
}

Table SPECIALIZATION {
  specialization_id integer [primary key, increment]
  name varchar [not null, unique]
}

Table DOCTOR {
  doctor_id integer [primary key, increment]
  user_id integer [not null, unique, ref: - USER.user_id]
  specialization_id integer [not null, ref: > SPECIALIZATION.specialization_id]
  experience_years integer [not null, default: 0]
  consultation_fee decimal
  rating decimal
  is_approved boolean [not null, default: false]

  Note: 'Profile for a user whose role is doctor.'
}

Table AVAILABILITY {
  availability_id integer [primary key, increment]
  doctor_id integer [not null, ref: > DOCTOR.doctor_id]
  day_of_week varchar [not null, note: 'mon | tue | wed | thu | fri | sat | sun']
  start_time time [not null]
  end_time time [not null]
  scheduling_type varchar [not null, note: 'wave | stream']
  slot_minutes integer [not null, note: 'Stream gap, for example 10. Wave window length, for example 30.']
  max_patients integer [not null, default: 1, note: 'Wave capacity. Stream is 1. Elastic scheduling raises this.']
}

Table SLOT {
  slot_id integer [primary key, increment]
  doctor_id integer [not null, ref: > DOCTOR.doctor_id]
  availability_id integer [not null, ref: > AVAILABILITY.availability_id]
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  capacity integer [not null, note: 'Wave: many patients. Stream: 1. Elastic: doctor can raise this.']
  booked_count integer [not null, default: 0]
  status varchar [not null, default: 'open', note: 'open | full | blocked']

  indexes {
    (doctor_id, slot_date, start_time) [unique]
  }
}

Table APPOINTMENT {
  appointment_id integer [primary key, increment]
  patient_id integer [not null, ref: > PATIENT.patient_id]
  doctor_id integer [not null, ref: > DOCTOR.doctor_id]
  slot_id integer [not null, ref: > SLOT.slot_id]
  status varchar [not null, default: 'booked', note: 'booked | completed | cancelled']
  reason varchar
  booked_at timestamp [not null, default: `now()`]

  indexes {
    (patient_id, slot_id) [unique, note: 'A patient books a slot only once']
  }
}

Table RESCHEDULE_HISTORY {
  reschedule_id integer [primary key, increment]
  appointment_id integer [not null, ref: > APPOINTMENT.appointment_id]
  old_slot_id integer [not null, ref: > SLOT.slot_id]
  new_slot_id integer [not null, ref: > SLOT.slot_id]
  rescheduled_at timestamp [not null, default: `now()`]
}
